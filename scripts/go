#!/bin/sh
set -eu

if [ -n "${SASA_GO:-}" ]; then
  toolchain="$SASA_GO"
elif command -v go >/dev/null 2>&1; then
  toolchain="$(command -v go)"
else
  toolchain="$HOME/.local/share/sasa/toolchains/go1.27.3/bin/go"
fi
if [ ! -x "$toolchain" ]; then
  echo "Go is unavailable. Install Go 1.27.3 or set SASA_GO to its executable." >&2
  exit 1
fi
case "${1:-}" in
  build|test|run|vet)
    exec python3 "$(dirname "$0")/mygo-input-style.py" "$toolchain" "$@"
    ;;
  *) exec "$toolchain" "$@" ;;
esac
