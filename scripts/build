#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
bundle="bin/Fuyu.app/Contents"
mkdir -p "$bundle/MacOS" "$bundle/Resources"
./scripts/go build -o "$bundle/MacOS/Fuyu" ./cmd/desktop
# Keep the original command pointing to the same application executable.
ln -sfn Fuyu.app/Contents/MacOS/Fuyu bin/fuyu
icon_work=$(mktemp -d "${TMPDIR:-/tmp}/fuyu-icon.XXXXXX")
trap 'rm -rf "$icon_work"' 0
iconset="$icon_work/Fuyu.iconset"
mkdir -p "$iconset"
for size in 16 32 128 256 512; do
  sips -z "$size" "$size" assets/app-icon.png --out "$iconset/icon_${size}x${size}.png" >/dev/null
  pixels=$((size * 2))
  sips -z "$pixels" "$pixels" assets/app-icon.png --out "$iconset/icon_${size}x${size}@2x.png" >/dev/null
done
iconutil -c icns "$iconset" -o "$bundle/Resources/Fuyu.icns"
cat > "$bundle/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleExecutable</key><string>Fuyu</string>
<key>CFBundleIdentifier</key><string>com.shenming.fuyu</string>
<key>CFBundleName</key><string>Fuyu</string>
<key>CFBundleDisplayName</key><string>Fuyu</string>
<key>CFBundleIconFile</key><string>Fuyu.icns</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>0.1.0</string>
<key>CFBundleVersion</key><string>1</string>
<key>NSHighResolutionCapable</key><true/>
</dict></plist>
PLIST
touch bin/Fuyu.app
lsregister="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
if [ -x "$lsregister" ]; then
  "$lsregister" -f "$PWD/bin/Fuyu.app"
fi
