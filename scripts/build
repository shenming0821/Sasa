#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
bundle="bin/Fuyu.app/Contents"
mkdir -p "$bundle/MacOS"
./scripts/go build -o "$bundle/MacOS/Fuyu" ./cmd/desktop
cat > "$bundle/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleExecutable</key><string>Fuyu</string>
<key>CFBundleIdentifier</key><string>com.shenming.fuyu</string>
<key>CFBundleName</key><string>Fuyu</string>
<key>CFBundleDisplayName</key><string>Fuyu</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>0.1.0</string>
<key>CFBundleVersion</key><string>1</string>
<key>NSHighResolutionCapable</key><true/>
</dict></plist>
PLIST
